  {/* 单例鼠标追踪与相变落地共振脚本 */}
  <script is:inline>
    let mouseFrame = null;
    window.addEventListener('mousemove', (e) => {
      if (mouseFrame) return;
      mouseFrame = requestAnimationFrame(() => {
        mouseFrame = null;
        const cards = document.querySelectorAll('.spotlight-card');
        for (let i = 0; i < cards.length; i++) {
          const card = cards[i];
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          if (x >= -80 && x <= rect.width + 80 && y >= -80 && y <= rect.height + 80) {
            card.style.setProperty('--mouse-x', `${x}px`);
            card.style.setProperty('--mouse-y', `${y}px`);
          }
        }
      });
    }, { passive: true });

    window.addEventListener('awakening-dock-landed', () => {
      const cards = document.querySelectorAll('[data-stage-dock]');
      cards.forEach((card, idx) => {
        setTimeout(() => {
          card.classList.add('dock-pulsing');
          setTimeout(() => card.classList.remove('dock-pulsing'), 650);
        }, idx * 60);
      });
    });
  </script>
